# TEDxUTTroyes 2027 : configuration Apache pour hebergement mutualise OVH

AddDefaultCharset UTF-8

# --------------------------------------------------------------------------
# HTTPS force et suppression du www.
# Si le certificat SSL n'est pas encore actif sur OVH, commentez les 4 lignes
# RewriteCond/RewriteRule ci-dessous le temps de l'activer.
# --------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --------------------------------------------------------------------------
# URL en dossiers : chaque page vit dans son dossier sous le nom index.html
# et se sert en /dossier/. Redirections 301 des anciennes URL .html
# (ancien site et premiere version de celui-ci) vers les dossiers.
# Le test porte sur THE_REQUEST (la requete externe d'origine) : la
# sous-requete interne de ErrorDocument vers /404.html n'est pas touchee.
# --------------------------------------------------------------------------
DirectoryIndex index.html

# Anciennes pages du site Webflow qui n'ont pas d'equivalent direct dans la
# nouvelle arborescence : la regle generique ci-dessous les enverrait vers un
# dossier inexistant, donc vers la 404. Ces redirections passent avant elle.
RewriteRule ^billetterie\.html$ https://www.helloasso.com/associations/geniusutt/evenements/tedxuttroyes-2027-10e-edition [R=301,L]
RewriteRule ^contact\.html$ /faq/ [R=301,L]
RewriteRule ^detail_localisation\.html$ / [R=301,L]
RewriteRule ^tous-les-speakers\.html$ /speakers/ [R=301,L]
RewriteRule ^toutes-les-editions\.html$ /editions/ [R=301,L]
RewriteRule ^speakers/([0-9]{4})/speaker-[0-9]{4}\.html$ /editions/edition-$1/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ /%1/ [R=301,L]

# Page 404 personnalisee
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Dossier de travail, hors site : design-system/ contient les sources du
# paquet de composants (export vers Claude Design). Il vit dans le depot
# mais ne fait pas partie du site et n'est lie depuis aucune page.
# --------------------------------------------------------------------------
RedirectMatch 404 ^/design-system(/|$)

# --------------------------------------------------------------------------
# Fichiers du depot : ils suivent le site quand on pousse le dossier tel quel
# a la racine du www, mais ils ne font pas partie du site. Le README et le
# CLAUDE.md decrivent notamment la page cachee du jeu de piste et son mot de
# passe : ils ne doivent pas etre lisibles en ligne.
# --------------------------------------------------------------------------
RedirectMatch 404 ^/(.*/)?(README|CLAUDE)\.md$
RedirectMatch 404 ^/(.*/)?\.(git|gitignore|htaccess)

# --------------------------------------------------------------------------
# Types MIME : les fichiers d'agenda (assets/agenda/*.ics) doivent partir
# en text/calendar, sinon Apple Calendrier et Samsung Calendrier ne les
# ouvrent pas et le navigateur affiche du texte brut.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/calendar .ics
  AddType image/webp .webp
</IfModule>

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Cache navigateur : long pour les assets (polices, images),
# moyen pour CSS et JS, aucun pour le HTML.
# Si vous modifiez main.css ou main.js apres la mise en ligne, le cache
# d'un mois peut retarder la prise en compte : changez alors le nom du
# fichier (ils s'appellent aujourd'hui main-v4.css, main-v3.js et
# line-v3.js) et les references dans les pages.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

{
  "name": "@tedxuttroyes/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Les composants React du site TEDxUTTroyes 2027 : le markup et les classes du site, empaquetes pour Claude Design. Aucune redefinition de style : la feuille unique du site est la source de verite.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "types": "tsc -p tsconfig.json --noEmit false",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "node demo.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}

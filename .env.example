# Modèle des variables d'environnement, sans aucune valeur. Les vraies valeurs
# vivent dans les réglages du projet Vercel (et dans .env.local pour le
# développement, jamais commis). Voir le README, section « Espace connecté ».

# Base Neon (fournies par l'intégration Neon de Vercel)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Hôte de la base de production, pour que l'anonymisation des
# prévisualisations ne s'applique jamais à la production
ESPACE_HOTE_BASE_PRODUCTION=

# Better Auth (une valeur différente en production et en prévisualisation)
BETTER_AUTH_SECRET=

# Domaine des membres (invitations hors domaine : dérogation d'un admin)
ESPACE_DOMAINE_MEMBRES=utt.fr

# E-mails (Scaleway Transactional Email, production uniquement)
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TEDxUTTroyes <noreply@tedxuttroyes.fr>
MAIL_REPLY_TO=geniusutt@utt.fr

# Stockage (Scaleway Object Storage, région fr-par)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_BUCKET_SAUVEGARDES=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tâche quotidienne (purges et sauvegarde)
CRON_SECRET=

# Tests sur les prévisualisations protégées
VERCEL_AUTOMATION_BYPASS_SECRET=
